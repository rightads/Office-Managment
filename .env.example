# ==============================================================================
# Right Ads Backend - Environment Variables Template
# ==============================================================================
# Copy this file to .env and provide your deployment-specific values.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Application Metadata & Core Runtime
APP_NAME=Right Ads Employee Management
ENVIRONMENT=development
DEBUG=false
APP_TIMEZONE=UTC

# Database Configuration (PostgreSQL with asyncpg driver)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/right_ads_db

# Security & Authentication (JWT)
# JWT_SECRET_KEY MUST be at least 32 characters long. App will refuse to start if shorter.
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Password Complexity Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins, or JSON array
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Pagination Policies
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload Policies
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_MIME_TYPES=["image/jpeg","image/png","image/webp","application/pdf"]

# Storage Backend (Options: local | s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET_NAME=right-ads-storage
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key_placeholder
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_placeholder
S3_ENDPOINT_URL=

# Push Notifications (Firebase Cloud Messaging)
# Path to service account JSON file
FCM_CREDENTIALS_PATH=./credentials/firebase-service-account.json

# Caching & Distributed Locks (Redis)
# Format: redis://[:password@]host:port/db_number
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Employee Profile Self-Service Whitelist
# Fields that employees can update on their own profile without administrative privileges
SELF_EDITABLE_PROFILE_FIELDS=["phone_number","avatar_url"]

# Attendance Engine & Background Automation (APScheduler)
FORGOTTEN_CHECKOUT_CUTOFF_HOURS=14
SCHEDULER_ENABLED=true
SCHEDULER_NIGHTLY_HOUR=23
SCHEDULER_NIGHTLY_MINUTE=50
